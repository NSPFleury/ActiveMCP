# Salesforce OAuth 2.0 - Username-Password Flow credentials
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# ---------------------------------------------------------------------------
# Salesforce Connected App credentials
# Create a Connected App in Salesforce Setup > App Manager and enable
# "Username-Password Flow" under OAuth Settings.
# ---------------------------------------------------------------------------
SF_CONSUMER_KEY=your_connected_app_consumer_key_here
SF_CONSUMER_SECRET=your_connected_app_consumer_secret_here

# ---------------------------------------------------------------------------
# Salesforce user credentials
# The security token is appended to the password automatically by auth.py.
# Reset your token at: Setup > My Personal Information > Reset My Security Token
# ---------------------------------------------------------------------------
SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_salesforce_password_here
SF_SECURITY_TOKEN=your_salesforce_security_token_here

# ---------------------------------------------------------------------------
# Login domain
#   "login"  -> production  (https://login.salesforce.com)
#   "test"   -> sandbox     (https://test.salesforce.com)
# ---------------------------------------------------------------------------
SF_DOMAIN=login

# ---------------------------------------------------------------------------
# Salesforce API version (optional - defaults to v59.0 if omitted)
# ---------------------------------------------------------------------------
SF_API_VERSION=v59.0
